# Optional: without these values the app runs in clearly-labeled DEMO AI mode.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6
PORT=8080

# Real sensor bridge
SENSOR_UDP_PORT=4210
SENSOR_COMMAND_PORT=4211
# R11.3: positive = stored surface-normal direction. Legacy UWB_Z_SIGN is ignored.
UWB_NORMAL_SIGN_V11=1
UWB_Z_SCALE=1.0
# R12 Adaptive Quality-Aware TDMA; use the matching protocol-3 Tag firmware.
UWB_TDMA_V12=1
# Successful NORMAL turns finish after one valid packet. VERIFY3/4 remains bounded by this lease.
UWB_LIVE_MAX_MS_V12=320
UWB_CAL_SLOT_MAX_MS_V12=680
UWB_PREPARE_MS_V12=140
UWB_SWITCH_GUARD_MS_V12=35
# Older V11 live/calibration timing overrides are intentionally ignored; use the V12 names above.
TAG_MEASUREMENT_STALE_MS=4500
TAG_RANGE_HOLD_MS_V11_5=2800
# Multi-Tag zero calibration uses fewer samples because each Tag gets a TDMA slot.
UWB_MULTI_TAG_CAL_SAMPLES=40

# Model-coordinate UWB calibration
# Valid samples required per Tag↔Anchor link after layout/Zero
UWB_CAL_SAMPLES_V10_1=180
# Minimum calibrated/consistent Anchor links used for displacement estimation
UWB_MIN_LINKS=2

# Deformation tracking time constant (precision mode uses fixed 1800 ms)
UWB_RESPONSIVE_TAU_MS=250
# Mark estimates above this sigma as reference-only (mm); keep finite values visible
UWB_MAX_SIGMA_MM=80

# R10.1: zero calibration targets about 15–20 seconds at ~10 Hz.
# Old R9 UWB_CAL_SAMPLES=1200 / UWB_CAL_MIN_MS=120000 are ignored by R10.1.
UWB_CAL_MIN_MS_V10_1=15000

# R10.2 deformation tracking stabilization
# Old UWB_RESPONSIVE_TAU_MS is intentionally ignored for R10.2 tracking.
UWB_RESPONSIVE_TAU_MS_V10_2=500
UWB_HOLD_SOFT_G=0.09
UWB_HOLD_HARD_G=0.16

# R12.3 browser SSE coalescing (ms). Registry still processes every UDP packet.
BROWSER_SNAPSHOT_MIN_MS=100

# R13.1 Unified Adaptive (no manual filter mode)
UWB_UNIFIED_TAU_QUIET_MS=1400
UWB_UNIFIED_TAU_MOTION_MS=420
UWB_SLIDING_WINDOW_MS=4000
